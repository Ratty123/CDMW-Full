    {
      "prefix": "shell.open.",
      "tool": "app.run_command",
      "class": "read",
      "note": "One per rail entry (cdmw/ui/shell/shell_commands.py tool_commands); app.open_tool runs them by key."
    },
    {
      "prefix": "mesh_editor.",
      "tool": "app.run_command",
      "class": "edit",
      "note": "Mirrored from the Mesh Editor helper's keymap at run time; mesh.command runs them by the helper's id. One whose id or label says build, export, delete or remove asks as output or destructive."
    }
  ],
