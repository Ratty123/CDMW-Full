#pragma code_page(65001)
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @CDMW_FILE_VERSION@
 PRODUCTVERSION @CDMW_FILE_VERSION@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG | @CDMW_VERSION_FLAGS@
#else
 FILEFLAGS @CDMW_VERSION_FLAGS@
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @CDMW_FILE_TYPE@
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "@CDMW_COMPANY_NAME@\0"
            VALUE "FileDescription", "@CDMW_DESCRIPTION@\0"
            VALUE "FileVersion", "@CDMW_APP_VERSION@\0"
            VALUE "InternalName", "@CDMW_INTERNAL_NAME@\0"
            VALUE "OriginalFilename", "@CDMW_ORIGINAL_FILENAME@\0"
            VALUE "ProductName", "@CDMW_PRODUCT_NAME@\0"
            VALUE "ProductVersion", "@CDMW_APP_VERSION@\0"
            VALUE "Comments", "Official repository: @CDMW_REPOSITORY_URL@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
