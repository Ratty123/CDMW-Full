<Window x:Class="Cdmw.ArchiveLite.App.Dialogs.ExportSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Cdmw.ArchiveLite.App.Infrastructure"
        Title="{infra:Loc Key=ExportChoiceTitle}"
        Width="660"
        Height="610"
        MinWidth="620"
        MinHeight="540"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="ExportChoiceRadioStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="15,13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="16"
                                        Height="16"
                                        VerticalAlignment="Top"
                                        BorderBrush="{DynamicResource BorderStrongBrush}"
                                        BorderThickness="2"
                                        CornerRadius="8">
                                    <Ellipse x:Name="Mark"
                                             Width="8"
                                             Height="8"
                                             Fill="{DynamicResource AccentBrush}"
                                             Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Grid.Column="1" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SelectionInactiveBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.42" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    CornerRadius="13,13,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="20,0,12,0"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource TitleFontSize}"
                               FontWeight="SemiBold"
                               Text="{infra:Loc Key=ExportChoiceTitle}"
                               IsHitTestVisible="False" />
                    <Border Grid.Column="0"
                            Background="Transparent"
                            MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown" />
                    <Button Grid.Column="1"
                            Width="46"
                            Height="50"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            ToolTip="{infra:Loc Key=Close}"
                            Content="&#x00D7;"
                            Click="OnCloseClick" />
                    <Border Grid.ColumnSpan="2"
                            VerticalAlignment="Bottom"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,22,26,22">
                    <TextBlock FontSize="{DynamicResource DialogTitleFontSize}"
                               FontWeight="SemiBold"
                               Text="{infra:Loc Key=ExportChoiceHeading}" />
                    <TextBlock x:Name="IntroText"
                               Margin="0,7,0,16"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" />

                    <RadioButton x:Name="FilesOnlyRadio"
                                 GroupName="ExportMode"
                                 IsChecked="True"
                                 Style="{StaticResource ExportChoiceRadioStyle}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{infra:Loc Key=ExportChoiceFilesOnlyTitle}" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Text="{infra:Loc Key=ExportChoiceFilesOnlyBody}" />
                            <Grid x:Name="FormatPanel" Margin="0,11,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,0,12,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{infra:Loc Key=ExportChoiceFormat}" />
                                <ComboBox x:Name="FormatComboBox"
                                          Grid.Column="1"
                                          MinWidth="230" />
                            </Grid>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="StructureRadio"
                                 GroupName="ExportMode"
                                 Style="{StaticResource ExportChoiceRadioStyle}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{infra:Loc Key=ExportChoiceStructureTitle}" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Text="{infra:Loc Key=ExportChoiceStructureBody}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="FamilyRadio"
                                 GroupName="ExportMode"
                                 Style="{StaticResource ExportChoiceRadioStyle}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{infra:Loc Key=ExportChoiceFamilyTitle}" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Text="{infra:Loc Key=ExportChoiceFamilyBody}" />
                        </StackPanel>
                    </RadioButton>

                    <StackPanel Margin="0,8,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Margin="0,0,9,0"
                                IsCancel="True"
                                Content="{infra:Loc Key=Cancel}" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                IsDefault="True"
                                Content="{infra:Loc Key=ExportChoiceAction}"
                                Click="OnContinueClick" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
