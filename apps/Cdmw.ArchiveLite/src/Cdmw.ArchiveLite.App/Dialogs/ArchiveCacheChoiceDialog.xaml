<Window x:Class="Cdmw.ArchiveLite.App.Dialogs.ArchiveCacheChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Cdmw.ArchiveLite.App.Infrastructure"
        Title="{infra:Loc Key=CacheChoiceTitle}"
        Width="684"
        Height="664"
        MinWidth="644"
        MinHeight="594"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="CacheChoiceButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="112" />
            <Setter Property="Padding" Value="18,15" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        </Style>
        <Style x:Key="PersistentCacheChoiceButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CacheChoiceButtonStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="{DynamicResource SelectionInactiveBrush}" />
        </Style>
    </Window.Resources>

    <Border x:Name="CacheDialogFrame"
            Margin="12"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="0"
                              Opacity="0.42"
                              Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    CornerRadius="13,13,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="Transparent"
                            MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown" />
                    <StackPanel Grid.Column="0"
                                Margin="20,0,12,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <TextBlock FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Text="{infra:Loc Key=CacheChoiceTitle}" />
                        <TextBlock Margin="0,2,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{infra:Loc Key=ReadOnlyFooter}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="46"
                            Height="54"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            FontSize="18"
                            ToolTip="{infra:Loc Key=Close}"
                            Content="&#x00D7;"
                            Click="OnCloseClick" />
                    <Border Grid.ColumnSpan="2"
                            VerticalAlignment="Bottom"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
            <Grid Margin="26,23,26,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Text="{infra:Loc Key=CacheChoiceHeading}" />
                <TextBlock Grid.Row="1"
                           Margin="0,7,0,0"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="{infra:Loc Key=CacheChoiceIntro}"
                           TextWrapping="Wrap"
                           TextTrimming="None" />

                <Border Grid.Row="2"
                        Margin="0,16,0,0"
                        Padding="12,9"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="0,0,8,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{infra:Loc Key=CacheChoiceSourceLabel}" />
                        <TextBlock x:Name="SourcePathText"
                                   Grid.Column="1"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <Button x:Name="PersistentButton"
                        Grid.Row="3"
                        Margin="0,15,0,0"
                        IsDefault="True"
                        Style="{StaticResource PersistentCacheChoiceButtonStyle}"
                        Click="OnPersistentClick">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PersistentTitleText"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="None" />
                        <Border Grid.Column="1"
                                Margin="12,0,0,0"
                                Padding="8,3"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="9">
                            <TextBlock FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       Text="{infra:Loc Key=CacheChoiceRecommended}" />
                        </Border>
                        <TextBlock x:Name="PersistentBodyText"
                                   Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Margin="0,7,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   TextTrimming="None" />
                    </Grid>
                </Button>

                <Button Grid.Row="4"
                        Margin="0,10,0,0"
                        Style="{StaticResource CacheChoiceButtonStyle}"
                        Click="OnSessionOnlyClick">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="{infra:Loc Key=CacheChoiceSessionTitle}"
                                   TextTrimming="None" />
                        <TextBlock Grid.Row="1"
                                   Margin="0,7,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{infra:Loc Key=CacheChoiceSessionBody}"
                                   TextWrapping="Wrap"
                                   TextTrimming="None" />
                    </Grid>
                </Button>

                <Border Grid.Row="5"
                        Margin="0,14,0,0"
                        Padding="12,9"
                        VerticalAlignment="Top"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="8">
                    <TextBlock Foreground="{DynamicResource WarningBrush}"
                               Text="{infra:Loc Key=CacheChoiceTimeNotice}"
                               TextWrapping="Wrap"
                               TextTrimming="None" />
                </Border>

                <Button Grid.Row="6"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Right"
                        IsCancel="True"
                        Content="{infra:Loc Key=Cancel}" />
            </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
