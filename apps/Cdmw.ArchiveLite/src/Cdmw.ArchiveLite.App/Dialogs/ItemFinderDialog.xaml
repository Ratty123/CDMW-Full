<Window x:Class="Cdmw.ArchiveLite.App.Dialogs.ItemFinderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Cdmw.ArchiveLite.App.Infrastructure"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{infra:Loc Key=ItemFinderTitle}"
        Width="1240"
        Height="800"
        MinWidth="940"
        MinHeight="640"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="18,0,8,0"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <TextBlock FontSize="{DynamicResource TitleFontSize}"
                               FontWeight="SemiBold"
                               Text="{infra:Loc Key=ItemFinderTitle}" />
                    <TextBlock Margin="0,2,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="{infra:Loc Key=ItemFinderSubtitle}" />
                </StackPanel>
                <Border Grid.Column="0"
                        Background="Transparent"
                        MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown" />
                <Button Grid.Column="1"
                        Width="48"
                        Height="54"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        FontSize="18"
                        ToolTip="{infra:Loc Key=Close}"
                        Content="&#x00D7;"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnCloseClick" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="14,12,14,10"
                Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                           Text="{infra:Loc Key=ItemFinderIntro}"
                           TextWrapping="Wrap" />
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="245" />
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             Margin="0,0,9,0"
                             VerticalContentAlignment="Center"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{infra:Loc Key=ItemFinderSearchHint}"
                             KeyDown="OnSearchKeyDown" />
                    <ComboBox Grid.Column="1"
                              Margin="0,0,9,0"
                              ItemsSource="{Binding CategoryOptions}"
                              SelectedItem="{Binding SelectedCategory}" />
                    <ComboBox Grid.Column="2"
                              Margin="0,0,9,0"
                              ItemsSource="{Binding MaterialTagOptions}"
                              SelectedItem="{Binding SelectedMaterialTag}" />
                    <Button Grid.Column="3"
                            Margin="0,0,9,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="{infra:Loc Key=Search}"
                            Command="{Binding SearchCommand}" />
                    <Button Grid.Column="4"
                            Content="{infra:Loc Key=Clear}"
                            Command="{Binding ClearCommand}" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="14,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="520" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="8">
                <Grid>
                    <ListBox x:Name="ItemGrid"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="False">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Width" Value="174" />
                                <Setter Property="Height" Value="182" />
                                <Setter Property="Margin" Value="4" />
                                <Setter Property="Padding" Value="7" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding InternalName}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="118" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="7">
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="34"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="{Binding FallbackText}" />
                                            <Image Width="112"
                                                   Height="112"
                                                   Source="{Binding Icon}"
                                                   Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="1"
                                               Margin="1,6,1,0"
                                               FontWeight="SemiBold"
                                               Text="{Binding DisplayName}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2"
                                               Margin="1,3,1,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="{DynamicResource CaptionFontSize}"
                                               Text="{Binding CategoryPath}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Background="{DynamicResource SurfaceBrush}"
                          Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="220" Height="7" IsIndeterminate="True" />
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{infra:Loc Key=ItemFinderLoading}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" />

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="120"
                                    Height="120"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <Grid>
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="34"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{Binding FallbackText}" />
                                    <Image Source="{Binding Icon}" Stretch="Uniform" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,2,0,0">
                                <TextBlock FontSize="{DynamicResource DialogTitleFontSize}"
                                           FontWeight="SemiBold"
                                           Text="{Binding DisplayName}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{Binding InternalName}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,7,0,0"
                                           Text="{Binding CategoryPath}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{Binding LinkedSummary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="{infra:Loc Key=ItemFinderEvidence}" />
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding Evidence}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding CategoryEvidence}"
                                   TextWrapping="Wrap" />

                        <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="{infra:Loc Key=ItemFinderLocalizedNames}" />
                        <TextBox IsReadOnly="True"
                                 Text="{Binding LocalizedNamesText, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent" />

                        <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="{infra:Loc Key=ItemFinderMaterials}" />
                        <TextBox IsReadOnly="True"
                                 Text="{Binding MaterialTagsText, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent" />

                        <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="{infra:Loc Key=ItemFinderModels}" />
                        <TextBox MinHeight="54"
                                 IsReadOnly="True"
                                 Text="{Binding ModelFilesText, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent" />

                        <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="{infra:Loc Key=ItemFinderIcons}" />
                        <TextBox MinHeight="54"
                                 IsReadOnly="True"
                                 Text="{Binding IconPathsText, Mode=OneWay}"
                                 TextWrapping="Wrap"
                                 BorderThickness="0"
                                 Background="Transparent" />

                        <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                            <Button Margin="0,0,8,0"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="{infra:Loc Key=ItemFinderShowExact}"
                                    ToolTip="{infra:Loc Key=ItemFinderShowExactHint}"
                                    Command="{Binding DataContext.ShowExactLinksCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="{infra:Loc Key=ItemFinderShowRelated}"
                                    ToolTip="{infra:Loc Key=ItemFinderShowRelatedHint}"
                                    Command="{Binding DataContext.ShowRelatedSetCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Margin="14,10,14,12"
                Padding="12,8"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="{DynamicResource CaptionFontSize}"
                               Text="{Binding IconWarmupStatus}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1"
                        Margin="10,0,7,0"
                        Content="{infra:Loc Key=PreviousPage}"
                        Command="{Binding PreviousPageCommand}" />
                <Button Grid.Column="2"
                        Margin="0,0,12,0"
                        Content="{infra:Loc Key=NextPage}"
                        Command="{Binding NextPageCommand}" />
                <Button Grid.Column="3"
                        Content="{infra:Loc Key=Close}"
                        Click="OnCloseClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
