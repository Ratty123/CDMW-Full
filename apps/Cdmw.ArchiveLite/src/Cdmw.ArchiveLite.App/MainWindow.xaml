<Window x:Class="Cdmw.ArchiveLite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:infra="clr-namespace:Cdmw.ArchiveLite.App.Infrastructure"
        mc:Ignorable="d"
        Title="{infra:Loc Key=ProductName}"
        Width="1500"
        Height="900"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <infra:ArchiveRoleLabelConverter x:Key="ArchiveRoleLabelConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="10">
            <TabItem Header="{infra:Loc Key=ArchiveBrowserTab}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="0,0,10,0" Text="{infra:Loc Key=ArchiveRoot}" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding ArchiveBrowser.ArchiveRoot, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{infra:Loc Key=ArchiveRoot}" />
                        <Button Grid.Column="2" Content="{infra:Loc Key=Browse}" Command="{Binding ArchiveBrowser.BrowseCommand}" />
                        <Button Grid.Column="3" Content="{infra:Loc Key=OpenArchive}" Command="{Binding ArchiveBrowser.OpenCommand}" />
                        <Button Grid.Column="4" Content="{infra:Loc Key=Refresh}" Command="{Binding ArchiveBrowser.RefreshCommand}" />
                        <Button Grid.Column="5" Content="{infra:Loc Key=Cancel}" Command="{Binding ArchiveBrowser.CancelCommand}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="245" MinWidth="210" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="3*" MinWidth="380" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="2*" MinWidth="300" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                            <StackPanel>
                                <GroupBox Header="{infra:Loc Key=Filters}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,4" Text="{infra:Loc Key=PathFilter}" />
                                        <TextBox Margin="0,0,0,8" Text="{Binding ArchiveBrowser.PathFilter, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="0,0,0,4" Text="{infra:Loc Key=ExtensionFilter}" />
                                        <TextBox Margin="0,0,0,8" Text="{Binding ArchiveBrowser.ExtensionFilter, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="0,0,0,4" Text="{infra:Loc Key=PackageFilter}" />
                                        <TextBox Margin="0,0,0,8" Text="{Binding ArchiveBrowser.PackageFilter, UpdateSourceTrigger=PropertyChanged}" />
                                        <CheckBox Margin="0,4,0,8"
                                                  Content="{infra:Loc Key=PreviewableOnly}"
                                                  IsChecked="{Binding ArchiveBrowser.PreviewableOnly}" />
                                        <TextBlock Margin="0,0,0,4" Text="{infra:Loc Key=ViewMode}" />
                                        <ComboBox Margin="0,0,0,8"
                                                  ItemsSource="{Binding ArchiveBrowser.ViewModes}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding ArchiveBrowser.ViewMode}" />
                                        <TextBlock Margin="0,0,0,4" Text="{infra:Loc Key=FolderFilter}" />
                                        <ComboBox Margin="0,0,0,8"
                                                  ItemsSource="{Binding ArchiveBrowser.Folders}"
                                                  SelectedItem="{Binding ArchiveBrowser.SelectedFolder}" />
                                        <TextBlock Margin="0,0,0,4" Text="{infra:Loc Key=RoleFilter}" />
                                        <ComboBox Margin="0,0,0,8"
                                                  ItemsSource="{Binding ArchiveBrowser.RoleFilters}"
                                                  SelectedItem="{Binding ArchiveBrowser.SelectedRole}" />
                                        <TextBlock Margin="0,0,0,4" Text="{infra:Loc Key=SortBy}" />
                                        <ComboBox Margin="0,0,0,4"
                                                  ItemsSource="{Binding ArchiveBrowser.SortFields}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding ArchiveBrowser.SortField}" />
                                        <CheckBox Margin="0,4,0,8"
                                                  Content="{infra:Loc Key=Descending}"
                                                  IsChecked="{Binding ArchiveBrowser.SortDescending}" />
                                        <Button Content="{infra:Loc Key=Search}" Command="{Binding ArchiveBrowser.ApplyFilterCommand}" />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="{infra:Loc Key=Folders}"
                                          Visibility="{Binding ArchiveBrowser.ShowFolderNavigator, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ListBox ItemsSource="{Binding ArchiveBrowser.Folders}"
                                             SelectedItem="{Binding ArchiveBrowser.SelectedFolder}"
                                             MaxHeight="170" />
                                </GroupBox>
                                <GroupBox Header="{infra:Loc Key=Categories}"
                                          Visibility="{Binding ArchiveBrowser.ShowCategoryNavigator, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ListBox ItemsSource="{Binding ArchiveBrowser.Categories}"
                                             SelectedItem="{Binding ArchiveBrowser.SelectedCategory}"
                                             MaxHeight="170" />
                                </GroupBox>
                                <GroupBox Header="{infra:Loc Key=ReadOnlyTools}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,4" Text="{infra:Loc Key=CollisionPolicy}" />
                                        <ComboBox Margin="0,0,0,8"
                                                  ItemsSource="{Binding ArchiveBrowser.CollisionPolicies}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding ArchiveBrowser.CollisionPolicy}" />
                                        <TextBlock Margin="0,0,0,4" Text="{infra:Loc Key=ManifestFormat}" />
                                        <ComboBox Margin="0,0,0,8"
                                                  ItemsSource="{Binding ArchiveBrowser.ManifestFormats}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding ArchiveBrowser.ManifestFormat}" />
                                        <Button Content="{infra:Loc Key=ExportSelected}" Command="{Binding ArchiveBrowser.ExportSelectedCommand}" />
                                        <Button Content="{infra:Loc Key=ExportFiltered}" Command="{Binding ArchiveBrowser.ExportFilteredCommand}" />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />
                        <Grid Grid.Column="2" Margin="8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid Grid.Row="0"
                                      ItemsSource="{Binding ArchiveBrowser.Entries}"
                                      SelectedItem="{Binding ArchiveBrowser.SelectedEntry}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      CanUserSortColumns="False"
                                      AlternationCount="2"
                                      ScrollViewer.CanContentScroll="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{infra:Loc Key=Name}" Binding="{Binding Name}" Width="180" />
                                    <DataGridTextColumn Header="{infra:Loc Key=Path}" Binding="{Binding Path}" Width="*" />
                                    <DataGridTextColumn Header="{infra:Loc Key=Type}" Binding="{Binding Role, Converter={StaticResource ArchiveRoleLabelConverter}}" Width="105" />
                                    <DataGridTextColumn Header="{infra:Loc Key=Size}" Binding="{Binding OriginalSize, StringFormat={}{0:N0}}" Width="95" />
                                    <DataGridTextColumn Header="{infra:Loc Key=Package}" Binding="{Binding Package}" Width="170" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Grid.Row="1" Margin="2,6,2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding ArchiveBrowser.TotalMatchesLabel}" />
                                <Button Grid.Column="1"
                                        Padding="9,3"
                                        Content="{infra:Loc Key=PreviousPage}"
                                        Command="{Binding ArchiveBrowser.PreviousPageCommand}" />
                                <TextBlock Grid.Column="2"
                                           MinWidth="120"
                                           Margin="8,0"
                                           HorizontalAlignment="Center"
                                           Text="{Binding ArchiveBrowser.PageSummary}" />
                                <Button Grid.Column="3"
                                        Padding="9,3"
                                        Content="{infra:Loc Key=NextPage}"
                                        Command="{Binding ArchiveBrowser.NextPageCommand}" />
                            </Grid>
                        </Grid>

                        <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />
                        <Grid Grid.Column="4" Margin="8,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Margin="0,0,0,8"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="{Binding ArchiveBrowser.PreviewTitle}" />
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="{StaticResource PanelBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Auto"
                                                      Visibility="{Binding ArchiveBrowser.IsImagePreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Image Margin="8"
                                                   Source="{Binding ArchiveBrowser.PreviewImage}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </ScrollViewer>
                                        <MediaElement Source="{Binding ArchiveBrowser.PreviewMediaSource}"
                                                      LoadedBehavior="Play"
                                                      UnloadedBehavior="Close"
                                                      Stretch="Uniform"
                                                      ScrubbingEnabled="True"
                                                      Visibility="{Binding ArchiveBrowser.IsMediaPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <avalonEdit:TextEditor IsReadOnly="True"
                                                               ShowLineNumbers="True"
                                                               WordWrap="True"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="12"
                                                               Background="{StaticResource PanelBackgroundBrush}"
                                                               Foreground="{StaticResource TextBrush}"
                                                               Padding="8"
                                                               Visibility="{Binding ArchiveBrowser.IsTextPreview, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                               infra:AvalonEditBinding.Text="{Binding ArchiveBrowser.PreviewText}" />
                                    </Grid>
                                </Border>
                                <Expander Grid.Row="1"
                                          Margin="0,6,0,0"
                                          Header="{infra:Loc Key=Metadata}"
                                          IsExpanded="False">
                                    <TextBox MaxHeight="150"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Text="{Binding ArchiveBrowser.PreviewMetadata, Mode=OneWay}" />
                                </Expander>
                                <TextBlock Grid.Row="2"
                                           Margin="2,6,2,0"
                                           Foreground="#FFFFC56D"
                                           TextWrapping="Wrap"
                                           Text="{Binding ArchiveBrowser.PreviewWarnings}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{infra:Loc Key=TextSearchTab}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="285" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" Padding="0,0,8,0">
                        <StackPanel>
                            <GroupBox Header="{infra:Loc Key=SearchSource}">
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding TextSearch.SourceOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding TextSearch.SourceKind}" />
                                    <TextBlock Margin="2,8,2,2"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="{infra:Loc Key=OpenArchiveFirst}"
                                               Visibility="{Binding TextSearch.IsArchiveSource, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <StackPanel Visibility="{Binding TextSearch.IsLooseFolderSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBox Margin="0,8,0,0" Text="{Binding TextSearch.LooseFolder, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Content="{infra:Loc Key=Browse}" Command="{Binding TextSearch.BrowseCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="{infra:Loc Key=Query}">
                                <StackPanel>
                                    <TextBox Text="{Binding TextSearch.Query, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Margin="0,8,0,0" Content="{infra:Loc Key=RegularExpression}" IsChecked="{Binding TextSearch.UseRegularExpression}" />
                                    <CheckBox Margin="0,6,0,8" Content="{infra:Loc Key=CaseSensitive}" IsChecked="{Binding TextSearch.CaseSensitive}" />
                                    <TextBlock Margin="0,0,0,4" Text="{infra:Loc Key=PathFilter}" />
                                    <TextBox Margin="0,0,0,8" Text="{Binding TextSearch.PathFilter, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,0,0,4" Text="{infra:Loc Key=Extensions}" />
                                    <TextBox AcceptsReturn="True" MinHeight="66" Text="{Binding TextSearch.Extensions, UpdateSourceTrigger=PropertyChanged}" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="{infra:Loc Key=Search}" Command="{Binding TextSearch.SearchCommand}" />
                                        <Button Content="{infra:Loc Key=Cancel}" Command="{Binding TextSearch.CancelCommand}" />
                                    </WrapPanel>
                                    <Button Content="{infra:Loc Key=ExportResults}" Command="{Binding TextSearch.ExportResultsCommand}" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />
                    <DataGrid Grid.Column="2"
                              Margin="8,0"
                              ItemsSource="{Binding TextSearch.Matches}"
                              SelectedItem="{Binding TextSearch.SelectedMatch}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{infra:Loc Key=Path}" Binding="{Binding Path}" Width="*" />
                            <DataGridTextColumn Header="{infra:Loc Key=Line}" Binding="{Binding Line}" Width="70" />
                            <DataGridTextColumn Header="{infra:Loc Key=Context}" Binding="{Binding Context}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />
                    <Grid Grid.Column="4" Margin="8,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Margin="0,0,0,8" FontSize="16" FontWeight="SemiBold" Text="{infra:Loc Key=Preview}" />
                        <avalonEdit:TextEditor Grid.Row="1"
                                               IsReadOnly="True"
                                               ShowLineNumbers="False"
                                               WordWrap="True"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="12"
                                               Background="{StaticResource PanelBackgroundBrush}"
                                               Foreground="{StaticResource TextBrush}"
                                               Padding="8"
                                               infra:AvalonEditBinding.Text="{Binding TextSearch.PreviewText}" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Status}" />
                <TextBlock Grid.Column="1" Margin="12,0,6,0" Foreground="{StaticResource MutedTextBrush}" Text="{infra:Loc Key=Language}" />
                <ComboBox Grid.Column="2"
                          MinWidth="92"
                          Padding="4,1"
                          ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding SelectedLanguage}" />
            </Grid>
        </Border>
    </Grid>
</Window>
