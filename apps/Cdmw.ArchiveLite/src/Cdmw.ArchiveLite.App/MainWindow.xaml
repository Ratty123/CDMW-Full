<Window x:Class="Cdmw.ArchiveLite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:controls="clr-namespace:Cdmw.ArchiveLite.App.Controls"
        xmlns:infra="clr-namespace:Cdmw.ArchiveLite.App.Infrastructure"
        mc:Ignorable="d"
        Title="{infra:Loc Key=ProductName}"
        Width="1440"
        Height="880"
        MinWidth="1200"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <infra:ArchiveRoleLabelConverter x:Key="ArchiveRoleLabelConverter" />
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="16,12,16,10">
            <TabItem Header="{infra:Loc Key=ArchiveBrowserTab}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           MinWidth="94"
                                           Margin="0,0,12,0"
                                           FontWeight="SemiBold"
                                           Text="{infra:Loc Key=ArchiveRoot}" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding ArchiveBrowser.ArchiveRoot, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{infra:Loc Key=ArchiveRoot}" />
                                <Button Grid.Column="2"
                                        Margin="10,0,0,0"
                                        Content="{infra:Loc Key=Browse}"
                                        Command="{Binding ArchiveBrowser.BrowseCommand}" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Text="{infra:Loc Key=ReadOnlyCaption}" />
                                <Button Grid.Column="1"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="{infra:Loc Key=OpenArchive}"
                                        Command="{Binding ArchiveBrowser.OpenCommand}" />
                                <Button Grid.Column="2"
                                        Margin="0,0,8,0"
                                        Content="{infra:Loc Key=Refresh}"
                                        Command="{Binding ArchiveBrowser.RefreshCommand}" />
                                <Button Grid.Column="3"
                                        Content="{infra:Loc Key=Cancel}"
                                        Command="{Binding ArchiveBrowser.CancelCommand}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,0,0,12"
                            Padding="12,9"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding ArchiveBrowser.IsOperationProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="{Binding ArchiveBrowser.OperationProgressText}" />
                            <ProgressBar Grid.Row="1"
                                         Margin="0,8,0,0"
                                         Maximum="100"
                                         Value="{Binding ArchiveBrowser.OperationProgressPercent, Mode=OneWay}"
                                         IsIndeterminate="{Binding ArchiveBrowser.IsOperationProgressIndeterminate, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="278" MinWidth="250" />
                            <ColumnDefinition Width="7" />
                            <ColumnDefinition Width="1.2*" MinWidth="410" />
                            <ColumnDefinition Width="7" />
                            <ColumnDefinition Width="*" MinWidth="350" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0"
                                      Margin="0,0,10,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <GroupBox Header="{infra:Loc Key=Filters}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,5" Text="{infra:Loc Key=PathFilter}" />
                                        <TextBox Margin="0,0,0,10" Text="{Binding ArchiveBrowser.PathFilter, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="0,0,0,5" Text="{infra:Loc Key=ExtensionFilter}" />
                                        <TextBox Margin="0,0,0,10" Text="{Binding ArchiveBrowser.ExtensionFilter, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="0,0,0,5" Text="{infra:Loc Key=PackageFilter}" />
                                        <TextBox Margin="0,0,0,10" Text="{Binding ArchiveBrowser.PackageFilter, UpdateSourceTrigger=PropertyChanged}" />
                                        <CheckBox Margin="0,1,0,10"
                                                  Content="{infra:Loc Key=PreviewableOnly}"
                                                  IsChecked="{Binding ArchiveBrowser.PreviewableOnly}" />
                                        <TextBlock Margin="0,0,0,5" Text="{infra:Loc Key=ViewMode}" />
                                        <ComboBox Margin="0,0,0,10"
                                                  ItemsSource="{Binding ArchiveBrowser.ViewModes}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding ArchiveBrowser.ViewMode}" />
                                        <TextBlock Margin="0,0,0,5" Text="{infra:Loc Key=FolderFilter}" />
                                        <ComboBox Margin="0,0,0,10"
                                                  ItemsSource="{Binding ArchiveBrowser.Folders}"
                                                  SelectedItem="{Binding ArchiveBrowser.SelectedFolder}" />
                                        <TextBlock Margin="0,0,0,5" Text="{infra:Loc Key=RoleFilter}" />
                                        <ComboBox Margin="0,0,0,10"
                                                  ItemsSource="{Binding ArchiveBrowser.RoleFilters}"
                                                  SelectedItem="{Binding ArchiveBrowser.SelectedRole}" />
                                        <TextBlock Margin="0,0,0,5" Text="{infra:Loc Key=SortBy}" />
                                        <ComboBox Margin="0,0,0,7"
                                                  ItemsSource="{Binding ArchiveBrowser.SortFields}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding ArchiveBrowser.SortField}" />
                                        <CheckBox Margin="0,1,0,10"
                                                  Content="{infra:Loc Key=Descending}"
                                                  IsChecked="{Binding ArchiveBrowser.SortDescending}" />
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Content="{infra:Loc Key=Search}"
                                                Command="{Binding ArchiveBrowser.ApplyFilterCommand}" />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="{infra:Loc Key=Folders}"
                                          Visibility="{Binding ArchiveBrowser.ShowFolderNavigator, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ListBox MaxHeight="180"
                                             ItemsSource="{Binding ArchiveBrowser.Folders}"
                                             SelectedItem="{Binding ArchiveBrowser.SelectedFolder}" />
                                </GroupBox>

                                <GroupBox Header="{infra:Loc Key=Categories}"
                                          Visibility="{Binding ArchiveBrowser.ShowCategoryNavigator, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ListBox MaxHeight="180"
                                             ItemsSource="{Binding ArchiveBrowser.Categories}"
                                             SelectedItem="{Binding ArchiveBrowser.SelectedCategory}" />
                                </GroupBox>

                                <GroupBox Header="{infra:Loc Key=ReadOnlyTools}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,5" Text="{infra:Loc Key=CollisionPolicy}" />
                                        <ComboBox Margin="0,0,0,10"
                                                  ItemsSource="{Binding ArchiveBrowser.CollisionPolicies}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding ArchiveBrowser.CollisionPolicy}" />
                                        <TextBlock Margin="0,0,0,5" Text="{infra:Loc Key=ManifestFormat}" />
                                        <ComboBox Margin="0,0,0,10"
                                                  ItemsSource="{Binding ArchiveBrowser.ManifestFormats}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding ArchiveBrowser.ManifestFormat}" />
                                        <Button Margin="0,0,0,8"
                                                Content="{infra:Loc Key=ExportSelected}"
                                                Command="{Binding ArchiveBrowser.ExportSelectedCommand}" />
                                        <Button Content="{infra:Loc Key=ExportFiltered}"
                                                Command="{Binding ArchiveBrowser.ExportFilteredCommand}" />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>

                        <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" />

                        <Border Grid.Column="2" Margin="10,0" Style="{StaticResource CardBorderStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DataGrid Grid.Row="0"
                                          BorderThickness="0"
                                          ItemsSource="{Binding ArchiveBrowser.Entries}"
                                          SelectedItem="{Binding ArchiveBrowser.SelectedEntry}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          CanUserSortColumns="False"
                                          AlternationCount="2"
                                          ScrollViewer.CanContentScroll="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{infra:Loc Key=Name}" Binding="{Binding Name}" Width="1.05*" MinWidth="110" />
                                        <DataGridTextColumn Header="{infra:Loc Key=Path}" Binding="{Binding Path}" Width="1.55*" MinWidth="145" />
                                        <DataGridTextColumn Header="{infra:Loc Key=Type}" Binding="{Binding Role, Converter={StaticResource ArchiveRoleLabelConverter}}" Width="78" />
                                        <DataGridTextColumn Header="{infra:Loc Key=Size}" Binding="{Binding OriginalSize, StringFormat={}{0:N0}}" Width="80" />
                                        <DataGridTextColumn Header="{infra:Loc Key=Package}" Binding="{Binding Package}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Row="1"
                                        Padding="12,8"
                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding ArchiveBrowser.TotalMatchesLabel}" />
                                        <Button Grid.Column="1"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Content="{infra:Loc Key=PreviousPage}"
                                                Command="{Binding ArchiveBrowser.PreviousPageCommand}" />
                                        <TextBlock Grid.Column="2"
                                                   MinWidth="112"
                                                   Margin="2,0,10,0"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Text="{Binding ArchiveBrowser.PageSummary}" />
                                        <Button Grid.Column="3"
                                                Style="{StaticResource CompactButtonStyle}"
                                                Content="{infra:Loc Key=NextPage}"
                                                Command="{Binding ArchiveBrowser.NextPageCommand}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="3" Width="7" HorizontalAlignment="Stretch" />

                        <Border Grid.Column="4" Margin="10,0,0,0" Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource SectionTitleStyle}"
                                               Text="{Binding ArchiveBrowser.PreviewTitle}" />
                                    <Border Grid.Column="1" Style="{StaticResource BadgeBorderStyle}" Margin="10,0,0,0">
                                        <TextBlock FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{infra:Loc Key=ReadOnlyBadge}" />
                                    </Border>
                                </Grid>

                                <Border Grid.Row="1"
                                        Margin="0,0,0,8"
                                        Padding="10,8"
                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Visibility="{Binding ArchiveBrowser.IsPreviewBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock TextWrapping="Wrap"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding ArchiveBrowser.PreviewProgressText}" />
                                        <ProgressBar Grid.Row="1"
                                                     Height="5"
                                                     Margin="0,7,0,0"
                                                     HorizontalAlignment="Stretch"
                                                     IsIndeterminate="True" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2"
                                        Background="{DynamicResource InputBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        ClipToBounds="True">
                                    <Grid>
                                        <controls:DotNetModelPreviewHost x:Name="ModelPreviewHost"
                                                                         PackagePath="{Binding ArchiveBrowser.ModelPreviewPackagePath, Mode=OneWay}"
                                                                         Visibility="{Binding ArchiveBrowser.IsModelPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Auto"
                                                      Visibility="{Binding ArchiveBrowser.IsImagePreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Image Margin="12"
                                                   Source="{Binding ArchiveBrowser.PreviewImage}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </ScrollViewer>
                                        <MediaElement Source="{Binding ArchiveBrowser.PreviewMediaSource}"
                                                      LoadedBehavior="Play"
                                                      UnloadedBehavior="Close"
                                                      Stretch="Uniform"
                                                      ScrubbingEnabled="True"
                                                      Visibility="{Binding ArchiveBrowser.IsMediaPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <avalonEdit:TextEditor IsReadOnly="True"
                                                               ShowLineNumbers="True"
                                                               WordWrap="True"
                                                               FontFamily="Consolas"
                                                               FontSize="12.5"
                                                               Background="{DynamicResource InputBackgroundBrush}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               Padding="12"
                                                               HorizontalScrollBarVisibility="Auto"
                                                               VerticalScrollBarVisibility="Auto"
                                                               Visibility="{Binding ArchiveBrowser.IsTextPreview, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                               infra:AvalonEditBinding.Text="{Binding ArchiveBrowser.PreviewText}" />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="3"
                                        Margin="0,7,0,0"
                                        Padding="10,8"
                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ArchiveBrowser.IsModelPreview}" Value="True" />
                                                        <Condition Binding="{Binding ElementName=ModelPreviewHost, Path=IsReady}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock TextWrapping="Wrap"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding ElementName=ModelPreviewHost, Path=StatusText}" />
                                        <ProgressBar Grid.Row="1"
                                                     Height="5"
                                                     Margin="0,7,0,0"
                                                     HorizontalAlignment="Stretch"
                                                     IsIndeterminate="True"
                                                     Visibility="{Binding ElementName=ModelPreviewHost, Path=IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Border>

                                <Expander Grid.Row="4"
                                          Margin="0,7,0,0"
                                          Header="{infra:Loc Key=Metadata}"
                                          IsExpanded="False">
                                    <TextBox MaxHeight="155"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Text="{Binding ArchiveBrowser.PreviewMetadata, Mode=OneWay}" />
                                </Expander>

                                <TextBlock Grid.Row="5"
                                           Margin="4,7,4,0"
                                           Foreground="{DynamicResource WarningBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="None"
                                           Text="{Binding ArchiveBrowser.PreviewWarnings}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{infra:Loc Key=TextSearchTab}">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" MinWidth="270" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="1.25*" MinWidth="410" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="*" MinWidth="350" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0"
                                  Margin="0,0,10,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <GroupBox Header="{infra:Loc Key=SearchSource}">
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding TextSearch.SourceOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding TextSearch.SourceKind}" />
                                    <TextBlock Margin="2,9,2,2"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Text="{infra:Loc Key=OpenArchiveFirst}"
                                               Visibility="{Binding TextSearch.IsArchiveSource, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <StackPanel Visibility="{Binding TextSearch.IsLooseFolderSource, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBox Margin="0,10,0,8" Text="{Binding TextSearch.LooseFolder, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Content="{infra:Loc Key=Browse}" Command="{Binding TextSearch.BrowseCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="{infra:Loc Key=Query}">
                                <StackPanel>
                                    <TextBox Text="{Binding TextSearch.Query, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Margin="0,10,0,4"
                                              Content="{infra:Loc Key=RegularExpression}"
                                              IsChecked="{Binding TextSearch.UseRegularExpression}" />
                                    <CheckBox Margin="0,0,0,10"
                                              Content="{infra:Loc Key=CaseSensitive}"
                                              IsChecked="{Binding TextSearch.CaseSensitive}" />
                                    <TextBlock Margin="0,0,0,5" Text="{infra:Loc Key=PathFilter}" />
                                    <TextBox Margin="0,0,0,10" Text="{Binding TextSearch.PathFilter, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,0,0,5" Text="{infra:Loc Key=Extensions}" />
                                    <TextBox AcceptsReturn="True"
                                             MinHeight="72"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"
                                             Text="{Binding TextSearch.Extensions, UpdateSourceTrigger=PropertyChanged}" />
                                    <Grid Margin="0,10,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Margin="0,0,5,0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Content="{infra:Loc Key=Search}"
                                                Command="{Binding TextSearch.SearchCommand}" />
                                        <Button Grid.Column="1"
                                                Margin="5,0,0,0"
                                                Content="{infra:Loc Key=Cancel}"
                                                Command="{Binding TextSearch.CancelCommand}" />
                                    </Grid>
                                    <Button Content="{infra:Loc Key=ExportResults}"
                                            Command="{Binding TextSearch.ExportResultsCommand}" />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" />

                    <Border Grid.Column="2" Margin="10,0" Style="{StaticResource CardBorderStyle}" Padding="0">
                        <DataGrid ItemsSource="{Binding TextSearch.Matches}"
                                  SelectedItem="{Binding TextSearch.SelectedMatch}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  AlternationCount="2"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{infra:Loc Key=Path}" Binding="{Binding Path}" Width="1.5*" MinWidth="210" />
                                <DataGridTextColumn Header="{infra:Loc Key=Line}" Binding="{Binding Line}" Width="74" />
                                <DataGridTextColumn Header="{infra:Loc Key=Context}" Binding="{Binding Context}" Width="2*" MinWidth="220" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <GridSplitter Grid.Column="3" Width="7" HorizontalAlignment="Stretch" />

                    <Border Grid.Column="4" Margin="10,0,0,0" Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Margin="0,0,0,11"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Text="{infra:Loc Key=Preview}" />
                            <Border Grid.Row="1"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    ClipToBounds="True">
                                <avalonEdit:TextEditor IsReadOnly="True"
                                                       ShowLineNumbers="False"
                                                       WordWrap="True"
                                                       FontFamily="Consolas"
                                                       FontSize="12.5"
                                                       Background="{DynamicResource InputBackgroundBrush}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       Padding="12"
                                                       HorizontalScrollBarVisibility="Auto"
                                                       VerticalScrollBarVisibility="Auto"
                                                       infra:AvalonEditBinding.Text="{Binding TextSearch.PreviewText}" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                MinHeight="48"
                Padding="16,7"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="0,0,16,0"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="{Binding Status}" />
                <TextBlock Grid.Column="1"
                           Margin="0,0,7,0"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="{infra:Loc Key=Theme}" />
                <ComboBox Grid.Column="2"
                          Width="132"
                          MinHeight="32"
                          Margin="0,0,18,0"
                          ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding SelectedTheme}" />
                <TextBlock Grid.Column="3"
                           Margin="0,0,7,0"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="{infra:Loc Key=Language}" />
                <ComboBox Grid.Column="4"
                          Width="112"
                          MinHeight="32"
                          ItemsSource="{Binding Languages}"
                          SelectedItem="{Binding SelectedLanguage}" />
            </Grid>
        </Border>
    </Grid>
</Window>
