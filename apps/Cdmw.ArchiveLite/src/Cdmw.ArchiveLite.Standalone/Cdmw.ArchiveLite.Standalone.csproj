<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>CdmwArchiveLite.Standalone</AssemblyName>
    <RootNamespace>Cdmw.ArchiveLite.Standalone</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <StripSymbols>true</StripSymbols>
    <DebugType>None</DebugType>
    <OptimizationPreference>Speed</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup Condition="'$(ArchiveLitePayloadPath)' != ''">
    <EmbeddedResource Include="$(ArchiveLitePayloadPath)" LogicalName="Cdmw.ArchiveLite.Standalone.Payload.zip" />
  </ItemGroup>
  <Target Name="RequireArchiveLitePayload" BeforeTargets="Publish"
          Condition="'$(ArchiveLitePayloadPath)' == '' or !Exists('$(ArchiveLitePayloadPath)')">
    <Error Text="ArchiveLitePayloadPath must identify the verified portable Archive Lite ZIP." />
  </Target>
</Project>
