<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>CdmwArchiveLite.Tests</AssemblyName>
    <RootNamespace>Cdmw.ArchiveLite.Tests</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Cdmw.ArchiveLite.App/Cdmw.ArchiveLite.App.csproj" />
    <ProjectReference Include="../../src/Cdmw.ArchiveLite.Contracts/Cdmw.ArchiveLite.Contracts.csproj" />
    <ProjectReference Include="../../src/Cdmw.ArchiveLite.Core/Cdmw.ArchiveLite.Core.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <NativeArchiveCorePath>$(MSBuildThisFileDirectory)..\..\..\..\native\cdmw_archive_core\build\$(Configuration)\cdmw-archive-core.dll</NativeArchiveCorePath>
  </PropertyGroup>
  <Target Name="CopyNativeArchiveCore" AfterTargets="Build" Condition="Exists('$(NativeArchiveCorePath)')">
    <Copy SourceFiles="$(NativeArchiveCorePath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
