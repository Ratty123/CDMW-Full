<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Cdmw.FullArchive.Tests</AssemblyName>
    <RootNamespace>Cdmw.FullArchive.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Cdmw.FullArchive.Contracts/Cdmw.FullArchive.Contracts.csproj" />
    <ProjectReference Include="../../src/Cdmw.FullArchive.Core/Cdmw.FullArchive.Core.csproj" />
    <ProjectReference Include="../../src/Cdmw.FullArchive.Worker/Cdmw.FullArchive.Worker.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <NativeArchiveCorePath>$(MSBuildThisFileDirectory)..\..\..\..\native\cdmw_full_archive_core\build\$(Configuration)\cdmw-full-archive-core.dll</NativeArchiveCorePath>
  </PropertyGroup>
  <Target Name="CopyNativeArchiveCore" AfterTargets="Build" Condition="Exists('$(NativeArchiveCorePath)')">
    <Copy SourceFiles="$(NativeArchiveCorePath)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
